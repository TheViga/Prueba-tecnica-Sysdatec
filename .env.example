# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tickets
# Host port for Postgres (container always uses 5432 internally).
# Change this if the port is already taken on your machine.
DB_PORT=5434

# ---- Backend ----
PORT=3004

# ---- Qwen / Alibaba DashScope (OpenAI-compatible API) ----
# Used for AI classification. Get a key at https://dashscope.console.aliyun.com/
QWEN_API_KEY=your_dashscope_api_key_here
# International endpoint. For mainland China use:
#   https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
