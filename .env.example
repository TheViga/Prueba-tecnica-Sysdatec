# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tickets
# Host port for Postgres (container always uses 5432 internally).
# Change this if the port is already taken on your machine.
DB_PORT=5434

# ---- Backend ----
PORT=3004

# ---- LLM (OpenAI-compatible provider) ----
# The classifier uses the OpenAI SDK, so any OpenAI-compatible endpoint works by
# changing the base URL and model below.
#
# Default: Cerebras (https://cloud.cerebras.ai -> API Keys). Key starts with "csk-".
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=gpt-oss-120b
#
# Other providers (same code, just swap these two lines):
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1
#               LLM_MODEL=qwen/qwen3-next-80b-a3b-instruct
#   DashScope:  LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#               LLM_MODEL=qwen-plus
